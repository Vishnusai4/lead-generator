# Zendesk Detection Pipeline - Environment Variables
# ====================================================

# Enrichment API Keys (optional - will use free fallback if not provided)
CLEARBIT_API_KEY=your_clearbit_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here

# Database
DATABASE_URL=sqlite:///leads.db

# Logging
LOG_LEVEL=INFO

# API
API_PORT=8000

# Detection
IGNORE_ROBOTS_TXT=false
USE_PLAYWRIGHT_ALL=false

# Rate Limiting
REQUESTS_PER_SECOND=1.0
